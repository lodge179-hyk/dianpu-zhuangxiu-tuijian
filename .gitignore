/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment files and credentials must never enter Git
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/pnpm-lock.yaml
/pnpm-workspace.yaml
/.wrangler/
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/
/data/

