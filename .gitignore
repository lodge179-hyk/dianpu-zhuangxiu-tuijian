.env*
bin/
obj/
.vs/
.idea/
.vscode/
output/
outputs/
tmp/
temp/
*.log
*.log.*
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.tmp*
.cache/
__pycache__/
*.py[cod]
.pytest_cache/
